# Skopiuj do .env i uzupełnij. Plik .env jest ignorowany przez git.
# Token do API wygenerujesz przez:  ./run-serwer.sh --nowy-token

OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o-mini

LANGGRAPH_TOKEN=wygenerowany-przez--nowy-token
LANGGRAPH_HOST=127.0.0.1
LANGGRAPH_PORT=8100

# Adres Twojej instancji n8n - z niej korzystają narzędzia Gmaila,
# kalendarza i wyszukiwarki.
N8N_BASE_URL=http://127.0.0.1:5678
N8N_TIMEOUT=30
